# Réglages de sauvegarde-base.sh. Copier en .sauvegarde.env, remplir, puis :
#   chmod 600 .sauvegarde.env
# Ce fichier donne accès à la base de prod : il ne quitte jamais le NAS et
# n'est jamais commité.

# Supabase (prod) → Connect → « Session pooler » (IPv4), avec le mot de passe
# de la base. Ex. :
# postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Clé PUBLIQUE age du fondateur (commence par age1…). La clé privée
# (AGE-SECRET-KEY-…) ne va JAMAIS ici.
AGE_RECIPIENT=

# Dossier de destination, idéalement un dossier partagé CHIFFRÉ du NAS.
DEST_DIR=/volume1/sauvegardes-tiroir

# Nombre de sauvegardes gardées (les plus anciennes sont retirées).
KEEP=30
