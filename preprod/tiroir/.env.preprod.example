# Variables d'environnement de la PREPROD Tiroir.
# Copier en .env.preprod et remplir avec les valeurs du PROJET SUPABASE DE PREPROD.
# NE JAMAIS mettre ici les valeurs de production.
# .env.preprod est ignoré par git (voir preprod/.gitignore).

# --- Supabase preprod (dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref-preprod>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-preprod>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-preprod>   # SECRET

# --- Torix : seul ce compte (adresse confirmée) accède au Torix Lab ---
# Sans cette variable, le Lab est fermé à tous, admins compris.
TORIX_OWNER_EMAIL=<adresse-du-fondateur>

# --- Secrets applicatifs (générer des valeurs propres à la preprod) ---
# Ex : openssl rand -hex 32
SHARE_LINK_SECRET=<secret-preprod>                      # SECRET
# Signature du cookie d'accès aux partages protégés (suggestions, v4).
# Optionnel : à défaut, la clé service est utilisée.
SHARE_COOKIE_SECRET=<secret-preprod>                    # SECRET
ANALYTICS_SALT=<salt-preprod>                           # SECRET

# --- Stripe, MODE TEST uniquement (strategie/paiements-stripe.md) ---
# Sans ces variables, le paiement reste fermé (« Bientôt disponible »).
# Une clé réelle (sk_live_…) est refusée tant que STRIPE_MODE=test.
STRIPE_MODE=test
STRIPE_SECRET_KEY=<sk_test_…>                           # SECRET
STRIPE_WEBHOOK_SECRET=<whsec_… affiché par « stripe listen »>  # SECRET
SITE_URL=http://192.168.1.23:8151
# Prix des abonnements (price_… de TEST), créés par scripts/stripe-setup.mjs.
STRIPE_PRICE_PREMIUM_MONTHLY=<price_…>
STRIPE_PRICE_PREMIUM_YEARLY=<price_…>
STRIPE_PRICE_PRO_MONTHLY=<price_…>
STRIPE_PRICE_PRO_YEARLY=<price_…>
# TVA 20 % (EI assujettie depuis le 08/11/2026) : taux txr_… de TEST créés
# par le même script. Sans eux, le paiement refuse de démarrer.
BILLING_VAT_MODE=assujetti
STRIPE_TAX_RATE_ID=<txr_… ajouté>
STRIPE_TAX_RATE_INCLUSIVE_ID=<txr_… compris>
# Mentions des factures (EI du fondateur).
BILLING_LEGAL_NAME=<Prénom Nom EI>
BILLING_SIRET=<siret>
BILLING_ADDRESS=<adresse>
BILLING_VAT_NUMBER=<FR…>
# Facultatif : horloge de test Stripe pour simuler un impayé.
# STRIPE_TEST_CLOCK_ID=<clock_…>

# --- Divers ---
OBJECTS_TABLE=objects
NODE_ENV=production
PORT=8151

# --- Messagerie privée (/messages, « Contacter le vendeur ») ---
# Sans RESEND_API_KEY, aucun e-mail ne part : ni la vérification d'un
# invité, ni les notifications. Les liens des e-mails pointent vers
# l'adresse du NAS : ils ne s'ouvrent que depuis le réseau de la maison.
RESEND_API_KEY=<clé Resend>                               # SECRET
# Chiffrement des messages (openssl rand -hex 32), propre à la préprod.
MESSAGES_KEY=<secret-preprod>                              # SECRET
