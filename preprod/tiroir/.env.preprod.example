# Variables d'environnement de la PREPROD Tiroir.
# Copier en .env.preprod et remplir avec les valeurs du PROJET SUPABASE DE PREPROD.
# NE JAMAIS mettre ici les valeurs de production.
# .env.preprod est ignoré par git (voir preprod/.gitignore).

# --- Supabase preprod (dashboard -> Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref-preprod>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-preprod>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-preprod>   # SECRET

# --- Secrets applicatifs (générer des valeurs propres à la preprod) ---
# Ex : openssl rand -hex 32
SHARE_LINK_SECRET=<secret-preprod>                      # SECRET
ANALYTICS_SALT=<salt-preprod>                           # SECRET

# --- Divers ---
OBJECTS_TABLE=objects
NODE_ENV=production
PORT=8151
