{
  "$description": "Jetons de design de Tiroir — SEULE source de vérité (décision du fondateur, 2026-09-29 : le site web actuel fait foi). Modifier ici, puis : node design/generate.mjs",
  "color": {
    "orange": { "value": "#F26900", "role": "Couleur principale : actions, liens, accents" },
    "orange-700": { "value": "#D85E00", "role": "Orange appuyé : survol, pression" },
    "beige": { "value": "#FFF4E6", "role": "Fond chaud des sections" },
    "beige-2": { "value": "#FFF8EF", "role": "Fond chaud plus clair" },
    "ink": { "value": "#121212", "role": "Texte principal" },
    "muted": { "value": "#5b5b5b", "role": "Texte secondaire" }
  },
  "font": {
    "body": { "value": "'Inter', system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif", "role": "Texte courant et titres" }
  },
  "radius": {
    "default": { "value": 16, "unit": "px", "role": "Arrondi des cartes et boutons" }
  },
  "shadow": {
    "default": { "value": "0 6px 20px rgba(0,0,0,0.06)", "role": "Ombre des cartes" }
  },
  "layout": {
    "max": { "value": 1440, "unit": "px", "role": "Largeur maximale du contenu (site)" }
  }
}
