# App branchée sur la PRÉ-PROD (projet Supabase « tiroir-preprod »).
# Copier en .env.preprod (ignoré par git), remplir, puis : npm run start:preprod
# Clés publiques uniquement (jamais service_role ici).
EXPO_PUBLIC_SUPABASE_URL=https://qjcwunmfhgkflebguoxo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

EXPO_PUBLIC_USE_MOCK_ASSISTANT=false

# RevenueCat : laisser vide. Avec les clés de prod, chaque compte de test
# de la pré-prod deviendrait un client dans le RevenueCat de production.
EXPO_PUBLIC_REVENUECAT_API_KEY=
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=
