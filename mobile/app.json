{
  "expo": {
    "name": "Tiroir",
    "slug": "tiroir-v2",
    "version": "4.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tiroir",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sirools.tiroir",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": ["fr", "en", "es", "de"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F26900"
      },
      "package": "com.tiroir.app",
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tiroir accède à votre photothèque pour ajouter des photos à vos objets.",
          "cameraPermission": "Tiroir utilise la caméra pour photographier vos objets.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa3c951d-bb0e-4398-8e90-3142a4f0d844"
      }
    },
    "owner": "sirools"
  }
}
