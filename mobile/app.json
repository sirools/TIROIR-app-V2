{
  "expo": {
    "name": "Tiroir",
    "slug": "tiroir-v2",
    "version": "4.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "tiroir",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sirools.tiroir",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#F26900"
      },
      "package": "com.tiroir.app",
      "permissions": [
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "enableFullScreenImage_legacy": true,
          "resizeMode": "cover",
          "backgroundColor": "#FFF8EF"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Tiroir accède à votre photothèque pour ajouter des photos à vos objets.",
          "cameraPermission": "Tiroir utilise la caméra pour photographier vos objets.",
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "es",
              "de",
              "pt-BR",
              "pt-PT"
            ],
            "android": [
              "fr",
              "en",
              "es",
              "de",
              "pt-BR",
              "pt-PT"
            ]
          }
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa3c951d-bb0e-4398-8e90-3142a4f0d844"
      }
    },
    "owner": "sirools",
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "es": "./locales/es.json",
      "de": "./locales/de.json",
      "pt-BR": "./locales/pt-BR.json",
      "pt-PT": "./locales/pt-PT.json"
    }
  }
}
