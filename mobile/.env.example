# Supabase — clés publiques uniquement (jamais service_role ici)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Activer le mock IA (true par défaut en dev, false quand chat-turn est déployé)
EXPO_PUBLIC_USE_MOCK_ASSISTANT=true

# RevenueCat — clés SDK publiques, une par plateforme (dashboard → API keys)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your-android-key

# ── Brique d'IA hybride « Fiche express » (hackathon #BuildHybridAI) ──
# true : l'app contient Firebase et l'écran Fiche express ; les autres
# fonctions d'IA sont absentes de ce build. Absent : rien ne change.
# À poser aussi dans le shell avant `npx expo prebuild` / `npx expo run:ios`
# (le profil EAS « hackathon » le fait déjà).
EXPO_PUBLIC_HACKATHON_BUILD=false
# Projet Firebase : console.firebase.google.com › Paramètres du projet ›
# Vos applications › app iOS (com.sirools.tiroir). Les quatre valeurs sont
# dans GoogleService-Info.plist : API_KEY, PROJECT_ID, GOOGLE_APP_ID,
# GCM_SENDER_ID. Le fichier .plist lui-même ne va pas dans le dépôt.
EXPO_PUBLIC_FIREBASE_IOS_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_IOS_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# App Check (obligatoire). true : fournisseur de debug — l'écran Fiche
# express affiche le jeton de l'installation, à enregistrer dans Firebase
# (Security › App Check › Apps › ⋮ › Manage debug tokens). false : DeviceCheck.
EXPO_PUBLIC_FIREBASE_APPCHECK_DEBUG=true
# Modèle Gemini du cloud. Vide : gemini-3.5-flash-lite.
EXPO_PUBLIC_FIREBASE_AI_CLOUD_MODEL=
