# Supabase — clés publiques uniquement (jamais service_role ici)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Activer le mock IA (true par défaut en dev, false quand chat-turn est déployé)
EXPO_PUBLIC_USE_MOCK_ASSISTANT=true

# RevenueCat — clés SDK publiques, une par plateforme (dashboard → API keys)
EXPO_PUBLIC_REVENUECAT_API_KEY=appl_your-ios-key
EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=goog_your-android-key
