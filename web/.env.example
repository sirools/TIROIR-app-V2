# Variables d'environnement du site (Next.js, Vercel).
# Copier en .env pour le développement local ; en préprod / prod, les
# poser dans Vercel (Settings › Environment Variables). Jamais de vraie
# valeur dans ce fichier.

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur seulement (webhook Stripe, routes API).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY + STRIPE_MODE, le paiement est fermé : les
# boutons affichent « Bientôt disponible ».
# STRIPE_MODE doit correspondre à la clé (test ↔ sk_test_/rk_test_,
# live ↔ sk_live_/rk_live_), sinon le paiement reste fermé.
STRIPE_MODE=test
# Clé secrète (ou restreinte) : Dashboard › Developers › API keys.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (/api/stripe/webhook) :
#   - en local : affiché par `stripe listen --forward-to localhost:3000/api/stripe/webhook` ;
#   - en préprod / prod : Dashboard › Developers › Webhooks › l'endpoint.
STRIPE_WEBHOOK_SECRET=
# Pas d'identifiant de prix (price_…) ici : chaque prix est retrouvé par
# sa lookup_key (web/lib/stripeConfig.ts), créée par
# `STRIPE_SECRET_KEY=… node scripts/stripe-setup.mjs`.

# Adresse publique du site, pour les retours de Stripe Checkout et du
# portail client (défaut : https://tiroir.app).
SITE_URL=http://localhost:3000

# ── Facturation (mentions légales des factures Business) ─────────
# franchise (défaut, art. 293 B du CGI) ou assujetti.
BILLING_VAT_MODE=franchise
BILLING_LEGAL_NAME=
BILLING_SIRET=
BILLING_ADDRESS=
# Seulement si BILLING_VAT_MODE=assujetti :
BILLING_VAT_NUMBER=
