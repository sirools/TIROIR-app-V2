# Variables d'environnement du site (Next.js, Vercel).
# Copier en .env pour le développement local ; en préprod / prod, les
# poser dans Vercel (Settings › Environment Variables). Jamais de vraie
# valeur dans ce fichier.

# ── Supabase ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service : serveur seulement (webhook Stripe, routes API).
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ───────────────────────────────────────────────────────
# Sans STRIPE_SECRET_KEY + STRIPE_MODE, le paiement est fermé : les
# boutons affichent « Bientôt disponible ».
# STRIPE_MODE doit correspondre à la clé (test ↔ sk_test_/rk_test_,
# live ↔ sk_live_/rk_live_), sinon le paiement reste fermé.
STRIPE_MODE=test
# Clé secrète (ou restreinte) : Dashboard › Developers › API keys.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (/api/stripe/webhook) :
#   - en local : affiché par `stripe listen --forward-to localhost:3000/api/stripe/webhook` ;
#   - en préprod / prod : Dashboard › Developers › Webhooks › l'endpoint.
STRIPE_WEBHOOK_SECRET=
# Identifiants des prix d'abonnement (price_…), différents en test et en
# réel : Dashboard › Catalogue de produits › Tiroir Premium / Tiroir Pro,
# ou la sortie de `STRIPE_SECRET_KEY=… node scripts/stripe-setup.mjs`.
# Grille du 08/11/2026 : Premium 15 €/mois, 150 €/an ; Pro 50 €/mois, 500 €/an.
# Laissés vides, le site retrouve le prix actif par sa lookup_key.
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Adresse publique du site, pour les retours de Stripe Checkout et du
# portail client (défaut : https://tiroir.app).
SITE_URL=http://localhost:3000

# ── TVA et mentions des factures ────────────────────────────────
# assujetti (depuis le 08/11/2026) : TVA 20 % ajoutée aux prix HT des
# abonnements, comprise dans les packs de crédits. Sans la variable (ou
# franchise) : aucune TVA, mention art. 293 B du CGI.
BILLING_VAT_MODE=assujetti
# Taux de TVA Stripe (txr_…), créés par scripts/stripe-setup.mjs :
# 20 % ajoutés (abonnements, Business) et 20 % compris (packs de crédits).
STRIPE_TAX_RATE_ID=
STRIPE_TAX_RATE_INCLUSIVE_ID=
# Identité de l'EI, en pied de chaque facture :
BILLING_LEGAL_NAME=
BILLING_SIRET=
BILLING_ADDRESS=
BILLING_VAT_NUMBER=

# Campagne Ulule. La page vient de la base (réglable dans /admin/ulule) ;
# cette adresse ne sert que si la base est illisible.
ULULE_PAGE_URL=https://fr.ulule.com/tiroir-app/

# ── Brique d'IA hybride « Fiche express » (hackathon #BuildHybridAI) ──
# true : la page /fiche-express existe. Absent : elle répond 404, et le
# site de production ne change pas.
NEXT_PUBLIC_HACKATHON_BUILD=false
# Projet Firebase : console.firebase.google.com › Paramètres du projet ›
# Vos applications › app web › « firebaseConfig ». Activer AI Services ›
# AI Logic avec le « Gemini Developer API ».
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# App Check (obligatoire pour Firebase AI Logic).
#   - En local : mettre « true », lancer la page, copier le jeton affiché
#     dans la console du navigateur, l'enregistrer dans Firebase (Security ›
#     App Check › Apps › ⋮ › Manage debug tokens), puis le coller ici.
#     Le jeton n'est lu que sur localhost ; ne jamais le poser dans Vercel.
#   - En ligne : clé de site reCAPTCHA Enterprise (type « Web »).
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=
NEXT_PUBLIC_FIREBASE_RECAPTCHA_ENTERPRISE_KEY=
# Modèle Gemini du cloud. Vide : gemini-3.5-flash-lite.
NEXT_PUBLIC_FIREBASE_AI_CLOUD_MODEL=
